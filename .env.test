# Test environment. Uses isolated DB/Redis and disables external integrations.
NODE_ENV=test
PORT=5001
HOST=127.0.0.1
APP_URL=http://localhost:5001

MONGODB_URI=mongodb://localhost:27017/fix_my_ride_test
MONGODB_NAME=fix_my_ride_test
MONGODB_MAX_POOL_SIZE=5
MONGODB_MIN_POOL_SIZE=1
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SSL=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

JWT_SECRET=test-secret-0000000000000000000000000000000000000001
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test-refresh-secret-0000000000000000000000000000001
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=8
SESSION_TIMEOUT_MINUTES=60
COOKIE_SECRET=test-cookie-secret

CORS_ALLOWED_ORIGINS=http://localhost:5001

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

LOG_LEVEL=silent
LOG_PRETTY=false

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM=noreply@fixmyride.test

STORAGE_PROVIDER=local
MAX_FILE_SIZE=10485760

PAYPAL_ENVIRONMENT=sandbox

ENABLE_SIGNUP=true
ENABLE_MFA=true
MAINTENANCE_MODE=false

SEED_DB=false
SEED_SAMPLE_DATA=false
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_FIRSTNAME=System
SEED_ADMIN_LASTNAME=Administrator
SEED_TENANT_NAME=Fix My Ride
SEED_TENANT_SLUG=fix-my-ride
