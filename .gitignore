# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock

# Environment
# Real secrets — never commit. These are git-ignored.
.env
.env.*
!.env.example
!.env.test
# Local overrides (per-developer) — also ignored.
.env.local
.env.*.local

# Build
dist/
build/
*.js.map
*.tsbuildinfo

# Generated AppSail deploy bundle (regenerated by `npm run appsail:prepare`;
# app-config.json holds real env vars/secrets once filled in, so keep it out of git too)
appsail-deploy/dist/
appsail-deploy/node_modules/
appsail-deploy/package.json
appsail-deploy/package-lock.json
appsail-deploy/app-config.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Runtime
tmp/
temp/

# Test
coverage/
.nyc_output/

# Misc
*.bak
*.tmp
*.temp
